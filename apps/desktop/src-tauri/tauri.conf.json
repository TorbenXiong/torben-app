{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Torben App",
  "version": "0.1.0",
  "identifier": "io.github.torbenxiong.torbenapp",
  "build": {
    "beforeDevCommand": "pnpm run prepare:bundled-tools && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "title": "Torben App",
        "width": 1180,
        "height": 760,
        "minWidth": 680,
        "minHeight": 560,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/TorbenXiong/torben-app/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerHooks": "windows/nsis-hooks.nsh",
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local-first application and runtime manager",
    "longDescription": "Torben App manages trusted application sources, exact versions, and terminal selections on Windows."
  }
}
